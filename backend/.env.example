# Copiar este archivo como backend/.env y completar los valores.

# PostgreSQL. Este valor coincide con el docker-compose.yml de la raiz.
# Con un PostgreSQL propio: postgresql+psycopg2://postgres:TU_PASSWORD@localhost:5432/foodstore_db
DATABASE_URL=postgresql+psycopg2://foodstore:foodstore@localhost:5432/foodstore_db
# Alternativa sin instalar nada: SQLite
# DATABASE_URL=sqlite:///./foodstore.db

# Minimo 32 caracteres. Cambiar por una clave propia.
SECRET_KEY=cambiar-esta-clave-de-al-menos-32-caracteres

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Origen del frontend habilitado en CORS (tiene que ser exacto, sin barra final)
FRONTEND_ORIGIN=http://localhost:5173
