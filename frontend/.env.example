# Copiar este archivo como frontend/.env

# URL base de la API. Tiene que incluir el prefijo /api/v1.
#
# 127.0.0.1 y no localhost: en Windows "localhost" resuelve primero a ::1 (IPv6)
# y uvicorn, por defecto, solo escucha en IPv4. Con localhost el navegador recibe
# ERR_EMPTY_RESPONSE y la aplicacion se queda sin datos.
VITE_API_URL=http://127.0.0.1:8000/api/v1
